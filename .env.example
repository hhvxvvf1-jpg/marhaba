# MARHABA Environment Configuration
# Copy to .env.local for production / staging deployments. Never commit real secrets.

# Canonical public site URL for Open Graph, sitemap & callbacks
NEXT_PUBLIC_SITE_URL=https://marhaba.ma
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (SQLite local default; configure DATABASE_URL when migrating to PostgreSQL)
# MARHABA_DB_PATH=./data/marhaba.db
# DATABASE_URL=postgresql://user:password@host:5432/marhaba

# HMAC-SHA256 session cookie signing secret (auto-generated in data/.session-secret if omitted in dev)
MARHABA_SESSION_SECRET=replace-with-64-char-random-hex-secret

# Payment Gateways (Sandbox mode is active when keys are unset)
# CMI_MERCHANT_ID=
# CMI_STORE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Transactional Email & WhatsApp / SMS OTP
# RESEND_API_KEY=
# WHATSAPP_CLOUD_API_TOKEN=

# External Travel Providers (eSIM & Flight GDS)
# ESIM_PROVIDER_API_KEY=
# FLIGHT_GDS_API_KEY=

# Cloud Media Storage (Cloudflare R2 / S3)
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional external AI LLM provider (MARHABA AI Assistant works deterministically on SQLite without keys)
# OPENAI_API_KEY=
